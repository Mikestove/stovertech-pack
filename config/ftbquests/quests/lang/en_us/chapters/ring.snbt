	quest.17D7BE80FD298826.title: "Data Shards"
	quest.17D7BE80FD298826.quest_desc: [
		"&bData shards&r hide in chests all over the world. Right-click one to decode the next entry of your journal."
		""
		"&eDecode 3 entries.&r"
