	quest.3EC764D89C26CA54.title: "More of the Story"
	quest.3EC764D89C26CA54.quest_desc: [
		"&eDecode 6 entries&r of your journal."
	]
	quest.529EFA9EC110B042.title: "The Whole Story (So Far)"
